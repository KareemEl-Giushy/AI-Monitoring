# LiteLLM Master Key (Used to access the proxy UI & admin endpoints)
LITELLM_MASTER_KEY=sk-1234

# Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here

# Ollama Base URL (Use host.docker.internal for Ollama running on the host machine)
OLLAMA_API_BASE=http://host.docker.internal:11434

# PostgreSQL Database Configuration (Used by LiteLLM to store spend & prompt logs)
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm_password
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:litellm_password@db:5432/litellm
